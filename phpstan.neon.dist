includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # Analyse against the lowest supported PHP version, whatever PHP runs it
    phpVersion: 80300
    paths:
        - src
        - tests
    # Analysed with laravel-mediatheque 1.1 installed: phpstan-mediatheque-v1.neon.dist
    excludePaths:
        - src/MediathequeV1
        - tests/MediathequeV1
    tmpDir: build/phpstan
